function ListItem({ item, index }: { item: string, index: number }) {
  return (
    {{ index + 1 }}. {{ item }}
  )
}

export function Test() {
  const fruits = ['Apple', 'Banana', 'Cherry'];

  return (
    Here's a list of items:
    {{ fruits.length > 0 && (
      There are fruits a plenty!
    ) }}
    
    {{ fruits.length === 0 ? (
      No fruits currently
    ): (
      # Fruits:
      {{ fruits.map((fruit, i) => (
        {{ i + 1 }}. {{ fruit }}
      ))}}
    )}}
  )
}
