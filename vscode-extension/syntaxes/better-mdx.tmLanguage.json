{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Better-MDX",
  "scopeName": "text.html.markdown.mdx.better",
  "patterns": [
    {
      "include": "#better-mdx-imports"
    },
    {
      "include": "#better-mdx-function"
    },
    {
      "include": "#better-mdx-typescript"
    },
    {
      "include": "#better-mdx-return"
    },
    {
      "include": "#better-mdx-markdown-content"
    }
  ],
  "repository": {
    "better-mdx-imports": {
      "patterns": [
        {
          "begin": "^(import)\\s+",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.better-mdx"
            }
          },
          "end": ";|$",
          "patterns": [
            {
              "include": "source.ts#import-declaration"
            }
          ],
          "name": "meta.import.better-mdx"
        }
      ]
    },
    "better-mdx-function": {
      "patterns": [
        {
          "begin": "^(function)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.better-mdx"
            },
            "2": {
              "name": "entity.name.function.better-mdx"
            },
            "3": {
              "patterns": [
                {
                  "include": "source.ts#parameter-list"
                }
              ]
            }
          },
          "end": "(?=return\\s*\\()",
          "patterns": [
            {
              "include": "#better-mdx-typescript"
            }
          ],
          "name": "meta.function.better-mdx"
        }
      ]
    },
    "better-mdx-typescript": {
      "patterns": [
        {
          "begin": "(?<=\\{|^)(?!return\\s*\\()",
          "end": "(?=return\\s*\\(|\\}$)",
          "patterns": [
            {
              "include": "source.ts"
            }
          ],
          "name": "source.ts.embedded.better-mdx"
        }
      ]
    },
    "better-mdx-return": {
      "patterns": [
        {
          "begin": "(return)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.return.better-mdx"
            }
          },
          "end": "\\)(?=\\s*\\}?$)",
          "patterns": [
            {
              "include": "#better-mdx-markdown-content"
            }
          ],
          "name": "meta.return.better-mdx"
        }
      ]
    },
    "better-mdx-markdown-content": {
      "patterns": [
        {
          "include": "#better-mdx-interpolation"
        },
        {
          "include": "#better-mdx-conditional"
        },
        {
          "include": "#better-mdx-jsx-elements"
        },
        {
          "include": "text.html.markdown#fenced_code_block"
        },
        {
          "include": "text.html.markdown#heading"
        },
        {
          "include": "text.html.markdown#list"
        },
        {
          "include": "text.html.markdown#bold"
        },
        {
          "include": "text.html.markdown#italic"
        },
        {
          "include": "text.html.markdown#link"
        },
        {
          "include": "text.html.markdown#inline_code"
        },
        {
          "include": "text.html.markdown#raw_block"
        }
      ]
    },
    "better-mdx-interpolation": {
      "patterns": [
        {
          "begin": "\\{\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.better-mdx"
            }
          },
          "end": "\\}\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.better-mdx"
            }
          },
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ],
          "name": "meta.embedded.expression.better-mdx source.ts.embedded.better-mdx"
        }
      ]
    },
    "better-mdx-conditional": {
      "patterns": [
        {
          "begin": "\\{([^}]+?)\\s*&&\\s*\\(",
          "beginCaptures": {
            "0": {
              "name": "meta.conditional.begin.better-mdx"
            },
            "1": {
              "patterns": [
                {
                  "include": "source.ts#expression"
                }
              ],
              "name": "source.ts.embedded.better-mdx"
            }
          },
          "end": "\\)\\s*\\}",
          "endCaptures": {
            "0": {
              "name": "meta.conditional.end.better-mdx"
            }
          },
          "patterns": [
            {
              "include": "#better-mdx-markdown-content"
            }
          ],
          "name": "meta.conditional.better-mdx"
        }
      ]
    },
    "better-mdx-jsx-elements": {
      "patterns": [
        {
          "begin": "<([A-Z]\\w*)(?:\\s+[^>]*)?/?>",
          "beginCaptures": {
            "0": {
              "name": "meta.tag.jsx.better-mdx"
            },
            "1": {
              "name": "entity.name.tag.jsx.better-mdx"
            }
          },
          "end": "</\\1>|(?<=/?>)",
          "endCaptures": {
            "0": {
              "name": "meta.tag.jsx.better-mdx"
            }
          },
          "patterns": [
            {
              "include": "source.tsx#jsx-children"
            },
            {
              "include": "#better-mdx-markdown-content"
            }
          ],
          "name": "meta.jsx.element.better-mdx"
        }
      ]
    }
  }
}