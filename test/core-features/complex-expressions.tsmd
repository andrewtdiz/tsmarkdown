function ListItem({ item, index }: { item: string, index: number }) {
  return (
    {{ item }} | {{ " " }}
  )
}

function Test() {
  const fruits = ['Apple', 'Banana', 'Cherry'];
  const user = { name: 'Alice', age: 30 };
  
  return (
    Here's a list of fruits:
    <fruits>
    {{ fruits.filter(f => f.length > 5).map((fruit, i) => (
      <@ListItem item={fruit} index={i} />
    ))}}
    </fruits>
  )
}
