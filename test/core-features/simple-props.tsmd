function Test({ items, withAnd }: { items: string[]; withAnd: boolean }) {
  
  if (items.length === 0) {
    return (
      Empty
    )
  }
  const itemsStr = items.length === 1 ? items[0] : items.slice(0, -1).join(', ') + (withAnd ? ' and ' : ', ') + items[items.length - 1]

  return (
    {{ itemsStr }}
  )
}
